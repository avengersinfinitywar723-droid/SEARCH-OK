"use client";
import { useEffect, useMemo, useState } from "react";
import type { Video } from "@/lib/types";
import { formatBytes } from "@/lib/types";
import { UploadForm } from "./UploadForm";
import { VideoCard } from "./VideoCard";
import { VideoModal } from "./VideoModal";
export function VideoApp() {
  const [videos, setVideos] = useState<Video[]>([]);
  const [loading, setLoading] = useState(true);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState<Video | null>(null);
  async function load() {
    try { const res = await fetch("/api/videos", { cache: "no-store" }); const data = await res.json(); setVideos(data.videos ?? []); }
    catch {}
    finally { setLoading(false); }
  }
  useEffect(() => { load(); }, []);
  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return videos;
    return videos.filter(v => v.title.toLowerCase().includes(q) || v.description.toLowerCase().includes(q) || v.originalName.toLowerCase().includes(q));
  }, [videos, query]);
  const totalSize = useMemo(() => videos.reduce((sum, v) => sum + (v.size ?? 0), 0), [videos]);
  async function handleDelete(id: number) {
    try { const res = await fetch(`/api/videos/${id}`, { method: "DELETE" }); if (res.ok) { setVideos(prev => prev.filter(v => v.id !== id)); if (active?.id === id) setActive(null); } } catch {}
  }
  return (
    <div className="mx-auto min-h-screen w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <header className="flex flex-col items-center gap-3 text-center">
        <div className="flex items-center gap-2">
          <span className="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-indigo-500 to-fuchsia-500 text-xl shadow-lg">🔎</span>
          <h1 className="bg-gradient-to-r from-indigo-300 via-white to-fuchsia-300 bg-clip-text text-3xl font-extrabold tracking-tight text-transparent sm:text-4xl">SEARCH OK</h1>
        </div>
        <p className="max-w-xl text-sm text-slate-400">Apni sabhi videos yahan upload karein — <span className="text-slate-200">unlimited</span>. Title ya description se turant <span className="text-indigo-300">search</span> karein.</p>
      </header>
      <div className="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <Stat label="Total Videos" value={String(videos.length)} />
        <Stat label="Total Size" value={formatBytes(totalSize)} />
        <Stat label="Search Results" value={query.trim() ? String(filtered.length) : "—"} />
      </div>
      <section className="mt-6"><UploadForm onUploaded={v => setVideos(prev => [v, ...prev])} /></section>
      <section className="mt-8">
        <div className="relative">
          <span className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">🔎</span>
          <input value={query} onChange={e => setQuery(e.target.value)} placeholder="Video search karein (title, description)…" className="w-full rounded-2xl border border-white/10 bg-white/5 py-3.5 pl-11 pr-4 text-sm text-white placeholder:text-slate-500 outline-none backdrop-blur transition focus:border-indigo-400" />
        </div>
      </section>
      <section className="mt-6">
        {loading ? <p className="py-16 text-center text-slate-400">Loading…</p> : filtered.length === 0 ? (
          <div className="rounded-3xl border border-dashed border-white/10 bg-white/5 py-16 text-center">
            <p className="text-4xl">🎬</p>
            <p className="mt-3 text-slate-300">{videos.length === 0 ? "Abhi koi video nahi hai. Upar se apna pehla video upload karein!" : "Koi match nahi mila. Search term change karein."}</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {filtered.map(v => (
              <VideoCard key={v.id} video={v} onOpen={() => setActive(v)} onDelete={() => { if (confirm(`"${v.title}" delete karein?`)) handleDelete(v.id); }} />
            ))}
          </div>
        )}
      </section>
      <footer className="mt-12 pb-6 text-center text-xs text-slate-600">SEARCH OK · Apni video, apni choice — unlimited uploads.</footer>
      {active && <VideoModal video={active} onClose={() => setActive(null)} onDelete={() => handleDelete(active.id)} />}
    </div>
  );
}
function Stat({ label, value }: { label: string; value: string }) {
  return <div className="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-center backdrop-blur"><p className="text-lg font-bold text-white">{value}</p><p className="text-xs text-slate-400">{label}</p></div>;
}
