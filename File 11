import { NextRequest, NextResponse } from "next/server";
import { eq } from "drizzle-orm";
import { unlink } from "fs/promises";
import { join } from "path";
import { db } from "@/db";
import { videos } from "@/db/schema";
import { ensureVideosTable } from "@/db/ensure";
import { UPLOADS_DIR } from "@/lib/storage";
export const dynamic = "force-dynamic";
export const runtime = "nodejs";
export async function DELETE(_req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
  await ensureVideosTable();
  const { id } = await params;
  const numId = Number(id);
  if (!Number.isInteger(numId)) return NextResponse.json({ error: "Invalid id" }, { status: 400 });
  const [row] = await db.select().from(videos).where(eq(videos.id, numId)).limit(1);
  if (!row) return NextResponse.json({ error: "Video nahi mila" }, { status: 404 });
  await unlink(join(UPLOADS_DIR, row.fileName)).catch(() => undefined);
  await db.delete(videos).where(eq(videos.id, numId));
  return NextResponse.json({ ok: true });
}
